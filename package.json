{
  "name": "wallet-hunter",
  "version": "1.0.0",
  "description": "WalletHunter — generate wallets and scan balances on Ethereum and BSC with email alerts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:eth": "node server/generate-wallets.js eth",
    "generate:bnb": "node server/generate-wallets.js bnb",
    "scan:eth": "node server/scan-eth.js",
    "scan:bnb": "node server/scan-bnb.js",
    "retry:eth": "node server/retry-eth.js",
    "retry:bnb": "node server/retry-bnb.js",
    "dashboard": "node server/web-server.js",
    "logo:process": "python scripts/process-logo.py"
  },
  "dependencies": {
    "bip39": "^3.1.0",
    "dotenv": "^17.4.2",
    "ethereumjs-wallet": "^1.0.2",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "web3": "^3.0.0-rc.1",
    "ws": "^8.21.1"
  }
}
